# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 git 에 올리지 않는다.

# Supabase 프로젝트 설정 → API 에서 확인 (anon/publishable 키만 쓴다.
# service_role 키는 절대 이 저장소나 클라이언트에 두지 않는다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 정식 배포 주소. sitemap.xml, robots.txt, canonical·OG 태그에 쓰인다.
# 빌드(npm run build) 시 반드시 있어야 한다 — 없으면 빌드가 멈춘다.
VITE_SITE_URL=https://www.hanmaumch.id
